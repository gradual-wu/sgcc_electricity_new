### 以下项都需要修改
## 国网登录信息
# 修改为自己的登录账号
PHONE_NUMBER="xxx" 
# 修改为自己的登录密码
PASSWORD="xxxx" 
# 排除指定用户ID，如果出现一些不想检测的ID或者有些充电、发电帐号、可以使用这个环境变量，如果有多个就用","分隔，","之间不要有空格
IGNORE_USER_ID=xxxxxxx,xxxxxxx,xxxxxxx

# DB_TYPE 数据储存类型 SQLITE / MYSQL，默认为 NONE 不进行数据储存
DB_TYPE=NONE

# sqlite 数据库名，默认为homeassistant
DB_NAME="homeassistant.db"
# COLLECTION_NAME默认为electricity_daily_usage_{国网用户id}，不支持修改。

# mysql 的数据库配置
MYSQL_HOST="mysql.lan"
MYSQL_USER="user"
MYSQL_PASSWORD="password"
MYSQL_DATABASE="sgcc"
MYSQL_PORT=3306

## homeassistant配置
# 改为你的localhost为你的homeassistant地址
HASS_URL="http://localhost:8123/"
# homeassistant的长期令牌（MQTT 接入后仅用于二维码通知和旧实体清理）
HASS_TOKEN="eyxxxxx"

## MQTT 配置（Home Assistant Mosquitto broker）
# broker 地址；留空时会自动使用 HASS_URL 的主机名
MQTT_HOST="localhost"
MQTT_PORT=1883
# Mosquitto 默认要求认证：填 HA 用户名/密码，或在加载项 logins 里添加账号
MQTT_USERNAME=""
MQTT_PASSWORD=""
# HA MQTT Discovery 前缀，保持默认即可
MQTT_DISCOVERY_PREFIX="homeassistant"
# 本程序发布状态使用的前缀
MQTT_STATE_PREFIX="sgcc_electricity"
# 实体 ID 后缀：none=无后缀（单户号推荐）；full=完整户号（多户号唯一）；last4=旧版后4位
ENTITY_ID_STYLE=none
# 从 last4 切换到 full 时，自动删除旧的后4位 MQTT Discovery 配置
CLEANUP_LEGACY_ENTITY_IDS=true
# 同一个 broker 上不要重复
MQTT_CLIENT_ID="sgcc_electricity_new"
MQTT_QOS=1
MQTT_RETAIN=true

## selenium运行参数
# 任务开始时间，24小时制，例如"07:00”则为每天早上7点执行，第一次启动程序如果时间晚于早上7点则会立即执行一次，每隔12小时执行一次。
JOB_START_TIME="07:00"
# 每次操作等待时间，推荐设定范围为[2,30]，该值表示每次点击网页后所要等待数据加载的时间，如果出现“no such element”诸如此类的错误可适当调大该值，如果硬件性能较好可以适当调小该值
RETRY_WAIT_TIME_OFFSET_UNIT=15
# 账单/交费/阶梯等数据页操作等待时间（秒），页面通常几秒内加载完成，默认 10
PAGE_WAIT_TIME=10


## 数据保留天数（仅对日用电和余额历史生效）
# 0 = 永久保留（推荐）；大于 0 时只清理超过该天数的日数据和余额历史
DATA_RETENTION_DAYS=0
# 每次从国网拉取最近多少天的日用电量，仅支持 7 或 30；日常建议 7
DAILY_FETCH_DAYS=7
# 日常入库时只核对最近多少天（首次全年回补不受此限制）
DAILY_RECONCILE_DAYS=7

## 交费记录 / 官方账单 / 阶梯 / 全年数据回补
# 读取交费记录页并把最近一次缴费时间、金额推送到 HA
PAYMENT_FETCH_ENABLED=true
# 交费记录查询起始日期；留空默认去年 1 月 1 日（保证能查到上一次缴费）
PAYMENT_FETCH_START=
# 单次最多查询多少条交费记录
PAYMENT_FETCH_LIMIT=200
# 日常交费记录同步间隔（天）；1 号总会同步，最近一次缴费超过该天数也会同步
PAYMENT_FETCH_INTERVAL_DAYS=7
# 每月自动补查缺失的官方电费账单（当月账单未出时会在后续运行重试）
BILL_SYNC_ENABLED=true
# 单次最多补查多少个月的官方账单
BILL_SYNC_MAX_MONTHS=12
# 读取“阶梯用电”页面保存官方阶梯状态
TIER_SYNC_ENABLED=true
# 阶梯边界：第一阶梯 0-2160，第二阶梯 2161-4200，第三阶梯 4201 以上
TIER1_MAX=2160
TIER2_MAX=4200
# 首次运行回补当年日用电量（按 90 天分段查询）
YEAR_BACKFILL_ENABLED=true
# 留空默认当年 1 月 1 日
YEAR_BACKFILL_START=
YEAR_BACKFILL_CHUNK_DAYS=30
# 强制重新回补当年日数据（排查用）
FORCE_YEAR_BACKFILL=false
# 强制全量刷新：全年日数据 + 官方账单 + 交费记录 + 阶梯快照；跑完请改回 false
FORCE_FULL_REFRESH=false

## PUSH_TYPE 余额不足提醒方式 PUSHPLUS / URLPUSH ，默认为None不通知
PUSH_TYPE=None
# 余额提现阈值，通知类型PUSHPLUS / URLPUSH 都生效
BALANCE=5.0
# pushplus token 如果有多个就用","分隔，","之间不要有空格，单个就不要有","
PUSHPLUS_TOKEN=xxxxxxx,xxxxxxx,xxxxxxx

# url_push 地址 通知body {"user_id": user_id, "balance": balance}
PUSH_URL="http://push.lan/notify"

# 密码登录失败（登录次数过多等）的备选方案
LOGIN_FALLBACK='qrcode'
# 二维码的提交地址
PUSH_QRCODE_URL="http://push.lan/qrcode"

# 二维码扫描后的最多等待时间 = QR_CODE_LOGIN_WAIT_COUNT x QR_CODE_LOGIN_WAIT_TIME_INTERVAL_UNIT
# 测试发现二维码默认有效期限为60s
# 二维码登录等待次数（18 x 10 秒 = 180 秒）
QR_CODE_LOGIN_WAIT_COUNT=18
#二维码登录等待间隔
QR_CODE_LOGIN_WAIT_TIME_INTERVAL_UNIT=10
# HA 加载项默认把二维码写到 /config/www；本地 Docker 运行时如未挂载该目录，
# 可改为 HA 配置目录下的 www 路径，例如 /path/to/homeassistant/www
HASS_WWW_DIR=/config/www

## 浏览器反检测参数（可选，默认值即可正常工作）
# 浏览器语言
# BROWSER_LANGUAGE=zh-HK,zh,en-US,en
# 浏览器窗口尺寸
# BROWSER_WINDOW_SIZE=1158,848
# 设备像素比
# BROWSER_DEVICE_SCALE_FACTOR=2
# 自定义 User-Agent（留空使用 Chrome 默认）
# BROWSER_USER_AGENT=

## ONNX Runtime 线程数限制（可选）
# 在 Docker 中限制了 CPU 数量时，设置此项可消除线程亲和度错误
# 建议设置为 Docker 分配的 CPU 核心数
# OP_NUM_THREADS=2

## 大模型验证码识别配置（必填）
# API Key，用于调用大模型解算腾讯验证码（点击+滑块）
# 支持任意 OpenAI 兼容 API（火山引擎、Google Gemini、OpenAI 等）
LLM_API_KEY="your-api-key-here"
# API 地址，默认火山引擎；Gemini 示例：https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# 模型名称，默认豆包；Gemini 示例：gemini-2.5-flash
LLM_MODEL="doubao-seed-2-0-pro-260215"

## 调试模式（可选）
# 设置为 true 启用短信验证码登录模式（需要人工在控制台输入短信验证码）
# DEBUG_MODE=false

## 用户名映射（可选）
# 为每个户号指定友好名称，格式：户号:名称,户号:名称
# USER_NAMES="1234567890:家庭用电,0987654321:公司用电"
